---
import { assetPath, sitePath } from '@/utils/paths';

interface Props {
  variant?: 'dark' | 'light';
}

const { variant = 'light' } = Astro.props;
const logoAsset = variant === 'light'
  ? 'images/branding/vsm-industrial-logo-white.webp'
  : 'images/branding/vsm-industrial-logo.webp';
---
<a href={sitePath('/')} class="group inline-flex items-center" aria-label="VSM Industrial, inicio">
  <img
    src={assetPath(logoAsset)}
    alt=""
    aria-hidden="true"
    width="2667"
    height="954"
    class="aspect-[2667/954] h-10 w-auto max-w-[min(12rem,40vw)] object-contain transition-transform duration-300 group-hover:scale-[1.02] motion-reduce:transition-none sm:h-12 sm:max-w-60"
  />
</a>
