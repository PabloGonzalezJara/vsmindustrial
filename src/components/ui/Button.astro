---
interface Props {
  href: string;
  variant?: 'primary' | 'light' | 'outline' | 'amber' | 'dark';
  ariaLabel?: string;
}
const { href, variant = 'primary', ariaLabel } = Astro.props;
const styles = {
  primary: 'bg-teal text-white hover:bg-[#0e8f89] hover:-translate-y-0.5',
  light: 'bg-white text-blue-dark hover:bg-sky-50 hover:-translate-y-0.5',
  outline: 'border border-white/40 text-white hover:border-white hover:bg-white/10',
  amber: 'bg-amber text-navy hover:bg-amber/90 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-amber/30',
  dark: 'bg-ink text-white hover:bg-navy hover:-translate-y-0.5',
};
---
<a href={href} aria-label={ariaLabel} class={`inline-flex min-h-12 items-center justify-center gap-3 rounded-full px-6 text-sm font-bold transition-all duration-200 ${styles[variant]}`}>
  <slot />
  <span aria-hidden="true">↗</span>
</a>
