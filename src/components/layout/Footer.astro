---
import Logo from '@/components/ui/Logo.astro';
import { sitePath } from '@/utils/paths';
const year = new Date().getFullYear();
const links = [
  { href: sitePath('/quienes-somos'), label: 'Quiénes somos' },
  { href: sitePath('/productos'), label: 'Productos' },
  { href: sitePath('/contacto'), label: 'Contacto' },
];
const contact = [
  { href: 'tel:+56957216357', label: '+56 9 5721 6357', sub: 'Lunes a viernes · 9:00 a 18:00' },
  { href: 'mailto:comunicaciones@grupovsm.cl', label: 'comunicaciones@grupovsm.cl', sub: 'Respuesta en 24 h hábiles' },
  { href: 'https://www.instagram.com/vimalchile/', label: '@vimalchile', sub: 'Instagram', external: true },
];
---
<footer class="relative overflow-hidden bg-navy-deep text-white">
  <div class="grid-pattern absolute inset-0 opacity-40"></div>
  <div class="absolute -right-32 top-0 size-96 rounded-full bg-teal/15 blur-3xl"></div>

  <div class="shell relative grid gap-12 py-16 lg:grid-cols-[1.4fr_1fr_1fr] lg:gap-10">
    <div>
      <Logo />
      <p class="mt-5 max-w-sm leading-7 text-slate-300">
        Fabricación e instalación de ventanas, termopaneles y estructuras de PVC y aluminio en Curicó y Talca.
      </p>
      <div class="mt-6 flex flex-wrap gap-2">
        <span class="inline-flex items-center gap-2 rounded-full border border-white/15 px-3 py-1 text-[0.65rem] font-bold uppercase tracking-[0.18em] text-slate-200">
          <span class="size-1.5 rounded-full bg-amber"></span>
          Certificación UBB
        </span>
        <span class="inline-flex items-center gap-2 rounded-full border border-white/15 px-3 py-1 text-[0.65rem] font-bold uppercase tracking-[0.18em] text-slate-200">
          <span class="size-1.5 rounded-full bg-teal"></span>
          PVC · Aluminio
        </span>
      </div>
    </div>

    <div>
      <p class="eyebrow">Explora</p>
      <nav class="mt-5 grid gap-3 text-sm text-slate-300">
        {links.map((link) => (
          <a class="group inline-flex items-center gap-2 transition-colors hover:text-white" href={link.href}>
            <span class="size-1.5 rounded-full bg-white/20 transition-colors group-hover:bg-teal"></span>
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    <div>
      <p class="eyebrow">Contacto directo</p>
      <div class="mt-5 grid gap-4 text-sm text-slate-300">
        {contact.map((item) => (
          <a class="group block transition-colors hover:text-white" href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noreferrer' : undefined}>
            <span class="font-bold text-white">{item.label}</span>
            <span class="mt-1 block text-xs text-slate-400">{item.sub}</span>
          </a>
        ))}
        <a class="inline-flex items-center gap-2 rounded-full border border-white/20 px-4 py-2 text-xs font-bold text-white transition-colors hover:border-amber hover:text-amber" href="https://wa.me/56957216357" target="_blank" rel="noreferrer">
          <span class="grid size-5 place-items-center rounded-full bg-teal text-[0.6rem] text-white" aria-hidden="true">W</span>
          WhatsApp directo
        </a>
      </div>
    </div>
  </div>

  <div class="relative border-t border-white/10">
    <div class="shell flex flex-col gap-3 py-6 text-xs text-slate-400 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} VSM Industrial. Todos los derechos reservados.</p>
      <p class="font-display text-slate-300">Equipamiento para una industria que avanza.</p>
    </div>
  </div>
</footer>
