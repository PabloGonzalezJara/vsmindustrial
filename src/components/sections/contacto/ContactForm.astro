<section id="contact-form" aria-labelledby="contact-form-title" class="relative mt-12 scroll-mt-24 overflow-hidden rounded-3xl border border-navy/10 bg-white shadow-panel">
  <div class="grid lg:grid-cols-[0.82fr_1.18fr]">
    <div class="relative isolate overflow-hidden bg-navy-deep p-7 text-white sm:p-10">
      <div class="grid-pattern pointer-events-none absolute inset-0 opacity-25" aria-hidden="true"></div>
      <div class="relative">
        <p class="eyebrow text-white/80">
          <span class="size-1.5 rounded-full bg-amber" aria-hidden="true"></span>
          Escríbenos
        </p>
        <h2 id="contact-form-title" class="font-display mt-5 text-3xl font-bold leading-tight tracking-tight sm:text-4xl">
          Cuéntanos de tu proyecto.
        </h2>
        <p class="mt-4 max-w-md text-base leading-7 text-slate-200">
          Déjanos los detalles de lo que necesitas y nuestro equipo podrá orientarte.
        </p>
        <p class="mt-10 border-l-2 border-amber pl-4 text-sm leading-6 text-slate-200">
          Responderemos usando los datos de contacto que compartas en el formulario.
        </p>
      </div>
    </div>

    <div class="p-6 sm:p-10">
     

      <form action="https://formspree.io/f/mgaokzpg" method="POST" class="space-y-5">
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="contact-name" class="block text-sm font-semibold text-navy-deep">
              Nombre <span class="ml-1 text-xs font-medium text-slate-600">* obligatorio</span>
            </label>
            <input
              id="contact-name"
              name="name"
              type="text"
              autocomplete="name"
              maxlength="100"
              required
              class="mt-2 min-h-12 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-base text-navy-deep placeholder:text-slate-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2"
            />
          </div>

          <div>
            <label for="contact-email" class="block text-sm font-semibold text-navy-deep">
              Correo electrónico <span class="ml-1 text-xs font-medium text-slate-600">* obligatorio</span>
            </label>
            <input
              id="contact-email"
              name="email"
              type="email"
              autocomplete="email"
              maxlength="254"
              required
              class="mt-2 min-h-12 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-base text-navy-deep placeholder:text-slate-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2"
            />
          </div>

          <div class="sm:col-span-2">
            <label for="contact-phone" class="block text-sm font-semibold text-navy-deep">
              Teléfono <span class="ml-1 text-xs font-medium text-slate-600">(opcional)</span>
            </label>
            <input
              id="contact-phone"
              name="phone"
              type="tel"
              autocomplete="tel"
              maxlength="30"
              class="mt-2 min-h-12 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-base text-navy-deep placeholder:text-slate-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2"
            />
          </div>

          <div class="sm:col-span-2">
            <label for="contact-message" class="block text-sm font-semibold text-navy-deep">
              Mensaje <span class="ml-1 text-xs font-medium text-slate-600">* obligatorio</span>
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="5"
              maxlength="3000"
              required
              class="mt-2 w-full resize-y rounded-xl border border-slate-300 bg-white px-4 py-3 text-base leading-6 text-navy-deep placeholder:text-slate-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2"
            ></textarea>
          </div>
        </div>

        <div class="hidden" aria-hidden="true">
          <input id="contact-website" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
        </div>

        

        <button
          type="submit"
          class="inline-flex min-h-12 w-full items-center justify-center gap-3 rounded-full bg-navy-deep px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-navy focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 sm:w-auto"
        >
          Enviar consulta
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </button>
      </form>
    </div>
  </div>
</section>
