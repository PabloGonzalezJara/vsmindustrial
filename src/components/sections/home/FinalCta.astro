---
import { sitePath } from '@/utils/paths';
---
<section class="relative overflow-hidden bg-navy-deep py-20 text-white sm:py-24">
  <div class="grid-pattern absolute inset-0 opacity-50"></div>
  <div class="absolute -right-32 top-0 size-96 rounded-full bg-amber/20 blur-3xl"></div>
  <div class="absolute -left-32 bottom-0 size-96 rounded-full bg-amber/20 blur-3xl"></div>

  <div class="shell relative grid gap-10 lg:grid-cols-[1.2fr_1fr] lg:items-center">
    <div>
      <span class="eyebrow">
        <span class="size-1.5 rounded-full bg-amber"></span>
        ¿Tienes un proyecto?
      </span>
      <h2 class="font-display mt-4 text-4xl font-bold leading-[1.05] tracking-tight sm:text-5xl">
        Hagámoslo realidad <span class="text-amber">juntos</span>
      </h2>
      <p class="mt-5 max-w-xl text-lg leading-8 text-slate-300">
        Conversemos sobre tu próximo proyecto de construcción. Te asesoramos con fabricación a medida y soporte post-venta. 
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-4 lg:justify-end">
      <a href={sitePath('/contacto')} class="inline-flex min-h-12 items-center gap-3 rounded-full bg-amber px-7 text-sm font-bold text-navy transition-transform duration-200 hover:-translate-y-0.5 hover:bg-amber/90 hover:shadow-xl hover:shadow-amber/20">
        Contactar a VSM <span aria-hidden="true">↗</span>
      </a>
      <a href="https://wa.me/56957216357" target="_blank" rel="noreferrer" class="inline-flex min-h-12 items-center gap-3 rounded-full border border-white/30 px-6 text-sm font-bold text-white transition-colors hover:border-white hover:bg-white/10">
        <span class="grid size-6 place-items-center rounded-full bg-amber text-[0.7rem] text-white" aria-hidden="true">W</span>
        WhatsApp directo
      </a>
    </div>
  </div>
</section>
