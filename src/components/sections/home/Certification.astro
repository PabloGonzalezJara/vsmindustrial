---
const badges = [
  { label: 'Universidad del Bío-Bío', sub: 'Calidad certificada' },
  { label: 'PVC + Aluminio', sub: 'Materiales premium' },
  { label: 'Curicó · Talca', sub: 'Atención regional' },
];
---
<section class="relative overflow-hidden bg-navy-deep py-20 text-white sm:py-28">
  <div class="grid-pattern absolute inset-0 opacity-50"></div>
  <div class="absolute -left-20 top-0 size-72 rounded-full bg-amber/15 blur-3xl"></div>
  <div class="absolute -right-20 bottom-0 size-72 rounded-full bg-teal/20 blur-3xl"></div>

  <div class="shell relative grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
    <div>
      <span class="eyebrow-amber">
        <span class="size-1.5 rounded-full bg-amber"></span>
        Calidad que respalda cada proyecto
      </span>
      <h2 class="font-display mt-5 max-w-xl text-4xl font-bold leading-[1.05] tracking-tight sm:text-5xl">
        Certificados por la <span class="text-amber">Universidad del Bío Bío</span>.
      </h2>
      <p class="mt-6 max-w-xl text-lg leading-8 text-slate-300">
        Ofrecemos productos con certificación de calidad de la Universidad del Bío-Bío, asegurando excelencia y confiabilidad para satisfacer las necesidades de nuestros clientes.
      </p>
      <div class="mt-8 border-l-2 border-amber/80 pl-5">
        <p class="text-base leading-7 text-slate-200">
          Somos especialistas en la fabricación e instalación de ventanas, ventanas termopanel, y estructuras de aluminio y PVC en Curicó y Talca.
        </p>
      </div>
    </div>

    <div class="relative">
      <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.04] shadow-panel">
        <img
          src="/images/home/certification-ubb.webp"
          alt="Placa de certificación de calidad Universidad del Bío-Bío"
          width="1200"
          height="900"
          loading="lazy"
          decoding="async"
          class="aspect-[4/3] w-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-navy-deep/40 via-transparent to-transparent"></div>
        <span class="absolute bottom-4 left-4 inline-flex items-center gap-2 rounded-full bg-amber/90 px-3 py-1.5 text-[0.65rem] font-bold uppercase tracking-[0.18em] text-navy">
          <span class="size-1.5 rounded-full bg-navy"></span>
          Calidad certificada UBB
        </span>
      </div>

      <div class="mt-5 grid gap-3 sm:grid-cols-3">
        {badges.map((badge, idx) => (
          <div class={`relative overflow-hidden rounded-xl border border-white/10 bg-white/[0.04] p-4 backdrop-blur-sm transition-colors hover:border-amber/40 hover:bg-white/[0.06] ${idx === 0 ? 'sm:col-span-3' : ''}`}>
            <div class="flex items-center gap-3">
              <span class={`grid size-9 place-items-center rounded-lg ${idx === 0 ? 'bg-amber/20 text-amber' : 'bg-teal/20 text-teal'}`}>
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12l5 5L20 7"/>
                </svg>
              </span>
              <div>
                <p class="font-display text-sm font-bold tracking-tight">{badge.label}</p>
                <p class="mt-0.5 text-[0.6rem] font-bold uppercase tracking-[0.18em] text-slate-400">{badge.sub}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
