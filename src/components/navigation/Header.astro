---
import Logo from '@/components/ui/Logo.astro';
import { sitePath } from '@/utils/paths';
const currentPath = Astro.url.pathname;
const links = [
  { path: '/quienes-somos', label: 'Quiénes somos' },
  { path: '/productos', label: 'Productos' },
  { path: '/contacto', label: 'Contacto' },
];
const normalizePath = (path: string) => path.replace(/\/+$/, '') || '/';
const isCurrent = (path: string) => {
  const normalizedCurrentPath = normalizePath(currentPath);
  return normalizedCurrentPath === normalizePath(path) || normalizedCurrentPath === normalizePath(sitePath(path));
};
---
<header class="absolute inset-x-0 top-0 z-20">
  <div class="shell flex min-h-20 items-center justify-between gap-6 border-b border-white/10 py-4 backdrop-blur-md">
    <Logo />
    <nav aria-label="Navegación principal" class="hidden items-center gap-1 md:flex">
      {links.map((link) => {
        const href = sitePath(link.path);
        const isActive = isCurrent(link.path);
        return (
          <a
            class={`nav-link group relative inline-flex min-h-10 items-center rounded-full px-4 text-sm font-semibold transition-colors ${isActive ? 'is-active text-white' : 'text-white/80 hover:text-white'}`}
            data-active={isActive}
            href={href}
            aria-current={isActive ? 'page' : undefined}
          >
            <span class="relative">
              {link.label}
              <!-- Sliding underline -->
              <span aria-hidden="true" class="nav-link-underline absolute -bottom-2 left-0 h-[3px] w-full origin-left scale-x-0 rounded-full bg-teal transition-transform duration-500 ease-out group-hover:scale-x-100 group-focus-visible:scale-x-100"></span>
              <!-- Glow dot -->
              <span aria-hidden="true" class="nav-link-dot absolute -bottom-3 left-1/2 size-1.5 -translate-x-1/2 rounded-full bg-teal opacity-0 transition-all duration-300 group-hover:opacity-100 group-hover:-bottom-1.5"></span>
            </span>
          </a>
        );
      })}
      <a href="tel:+56957216357" class="hidden items-center gap-2 border-l border-white/15 pl-5 text-xs font-bold text-white/75 transition-colors hover:text-white xl:flex">
        <span class="grid size-7 place-items-center rounded-full bg-teal/15 text-teal" aria-hidden="true">��</span>
        +56 9 5721 6357
      </a>
      <a href={sitePath('/contacto')} class="ml-2 inline-flex min-h-11 items-center gap-2 rounded-full bg-amber px-5 text-sm font-bold text-navy transition-transform duration-200 hover:-translate-y-0.5 hover:bg-amber/90 hover:shadow-lg hover:shadow-amber/20">
        Hablemos <span aria-hidden="true">↗</span>
      </a>
    </nav>
    <details class="group relative md:hidden">
      <summary class="flex min-h-11 cursor-pointer list-none items-center gap-3 rounded-full border border-white/30 px-4 py-2 text-sm font-bold text-white focus-visible:outline-teal">
        <span>Menú</span>
        <span class="text-teal transition-transform duration-300 group-open:rotate-45" aria-hidden="true">+</span>
      </summary>
      <nav aria-label="Navegación móvil" class="absolute right-0 top-16 w-[min(18rem,calc(100vw-2.5rem))] overflow-hidden rounded-2xl border border-line bg-white shadow-panel">
        <p class="border-b border-line-soft px-5 pb-3 pt-4 text-[0.65rem] font-bold uppercase tracking-[0.2em] text-ink-soft">Explora VSM</p>
        <div class="p-2">
          {links.map((link) => (
            <a class={`flex min-h-12 items-center justify-between rounded-xl px-4 py-3 text-sm font-bold transition-colors hover:bg-sand ${isCurrent(link.path) ? 'bg-sand text-blue' : 'text-ink'}`} href={sitePath(link.path)} aria-current={isCurrent(link.path) ? 'page' : undefined}>
              {link.label}
              {isCurrent(link.path) && <span class="text-teal" aria-hidden="true">●</span>}
            </a>
          ))}
        </div>
        <div class="border-t border-line-soft p-2">
          <a class="flex min-h-12 items-center justify-center rounded-xl bg-amber px-4 py-3 text-sm font-bold text-navy" href={sitePath('/contacto')}>Hablemos <span aria-hidden="true" class="ml-2">↗</span></a>
          <a class="mt-2 flex min-h-12 items-center justify-center rounded-xl bg-navy px-4 py-3 text-sm font-bold text-white" href="tel:+56957216357">Llamar ahora</a>
        </div>
      </nav>
    </details>
  </div>
</header>

<style>
  /* Active link: stronger underline + accent ring */
  .nav-link.is-active .nav-link-underline {
    transform: scaleX(1);
    background: linear-gradient(90deg, #13a7a0 0%, #2ec4b9 50%, #f5a524 100%);
    box-shadow: 0 0 12px rgb(19 167 160 / 0.55);
  }
  .nav-link.is-active .nav-link-dot {
    opacity: 1;
    bottom: -0.375rem;
    background: #f5a524;
    box-shadow: 0 0 10px rgb(245 165 36 / 0.7);
  }
  /* Animated hover ring (focus background) */
  .nav-link::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.08) 0%, rgb(255 255 255 / 0) 100%);
    border: 1px solid transparent;
    transition: background-color 250ms ease, border-color 250ms ease, transform 250ms ease;
    transform: scale(0.92);
    pointer-events: none;
  }
  .nav-link:hover::before,
  .nav-link:focus-visible::before {
    background-color: rgb(255 255 255 / 0.06);
    border-color: rgb(255 255 255 / 0.18);
    transform: scale(1);
  }
  .nav-link.is-active::before {
    background-color: rgb(19 167 160 / 0.12);
    border-color: rgb(19 167 160 / 0.35);
    transform: scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-link-underline,
    .nav-link-dot,
    .nav-link::before {
      transition: none !important;
    }
  }
</style>
