---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactDetails from '@/components/sections/contacto/ContactDetails.astro';
import ContactForm from '@/components/sections/contacto/ContactForm.astro';
---
<BaseLayout
  title="Contacto"
  description="Contacta a VSM Industrial en Talca por formulario, teléfono, correo electrónico, WhatsApp o Instagram."
>
  <section class="relative overflow-hidden bg-navy-deep pb-24 pt-36 text-white sm:pb-32 sm:pt-44">
    <div class="grid-pattern absolute inset-0 opacity-60"></div>
    <div class="absolute -right-40 top-10 size-[28rem] rounded-full bg-blue/30 blur-3xl"></div>
    <div class="absolute -bottom-32 -left-20 size-[24rem] rounded-full bg-amber/20 blur-3xl"></div>

    <div class="shell relative grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div>
        <span class="eyebrow">
          <span class="size-1.5 rounded-full bg-amber"></span>
          Contacto directo
        </span>
        <h1 class="font-display mt-5 max-w-3xl text-5xl font-bold leading-[0.98] tracking-[-0.035em] text-shadow-display sm:text-7xl">
          Estamos listos para <span class="relative inline-block text-amber">
            ayudarte
            <svg class="absolute -bottom-2 left-0 w-full" viewBox="0 0 200 8" fill="none" preserveAspectRatio="none" aria-hidden="true">
              <path d="M2 6 Q 50 1, 100 5 T 198 4" stroke="#1d8eea" stroke-width="3" stroke-linecap="round"/>
            </svg>
          </span>
        </h1>
        <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-300">
          Contáctanos directamente para conocer nuestras soluciones de ventanas, termopaneles y estructuras.
        </p>
      </div>
      <!-- Replace public/images/contacto/contacto-hero.webp with the final image; update alt to describe an informative replacement. -->
      <img
        src="/images/contacto/contacto-hero.webp"
        alt="Operarios trabajando con paneles de vidrio en una planta de fabricación."
        width="1536"
        height="1024"
        class="aspect-[3/2] w-full rounded-2xl border border-white/10 object-cover"
      />
    </div>
  </section>

  <section class="relative bg-sand py-20 sm:py-28">
    <div class="grid-pattern-light absolute inset-0 opacity-50"></div>
    <div class="shell relative max-w-5xl">

      <ContactForm />
      <div class="mt-8">
        <ContactDetails />
      </div>

    </div>
  </section>

  <script is:inline>
    const enterAtContactForm = () => {
      if (window.location.hash) return;

      const navigation = window.performance.getEntriesByType('navigation')[0];
      if (navigation?.type === 'back_forward') return;

      document.getElementById('contact-form')?.scrollIntoView({
        behavior: 'instant',
        block: 'start',
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', enterAtContactForm, { once: true });
    } else {
      enterAtContactForm();
    }
  </script>
</BaseLayout>
